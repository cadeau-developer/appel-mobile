# Disable Expo's HTTP cache (fixes "Body is unusable" on Node 24)
EXPO_NO_CACHE=1

# Public backend API base URL.
EXPO_PUBLIC_API_URL=https://api.smartattendance.site

# Optional: show a demo login hint on the login screen.
# Leave unset to hide the hint. Never commit real credentials.
# EXPO_PUBLIC_DEMO_EMAIL="demo@example.com"
# EXPO_PUBLIC_DEMO_PASSWORD="demo-password"
