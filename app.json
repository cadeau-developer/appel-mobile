{
  "expo": {
    "name": "Appel",
    "slug": "cahier-d-appel",
    "version": "1.0.0",
    "scheme": "attendance",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#2563EB",
    "newArchEnabled": false,
    "icon": "./assets/logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cahierdappel.mobile",
      "buildNumber": "1",
      "backgroundColor": "#2563EB"
    },
    "android": {
      "package": "com.cahierdappel.mobile",
      "versionCode": 13,
      "backgroundColor": "#2563EB",
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#2563EB"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#1E40AF",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "name": "Appel",
      "shortName": "Appel",
      "themeColor": "#2563EB",
      "backgroundColor": "#E8F2FF",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Appel to use your camera to take profile and student photos.",
          "photosPermission": "Allow Appel to access your photos for profiles, students and school logos.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "93f070d0-30ae-4330-986f-271c41e152da"
      }
    },
    "owner": "cadeauagaind"
  }
}
